{
  "name": "vimo-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "npm run build && npm start",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/data/setup.js",
    "db:seed:demo": "npm run build && node --env-file-if-exists=.env dist/data/setup.js --seed-demo",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "~6.0.3"
  },
  "engines": { "node": ">=24" }
}
